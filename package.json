{
  "name": "except",
  "version": "1.0.0",
  "description": "A function that returns a copy of the plain object given as first argument but without the keys provided as the other argument(s)",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./index.d.ts": "./index.d.ts",
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      },
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "index.d.cts"
  ],
  "scripts": {
    "format": "prettier --write .",
    "build": "tsup index.ts --format cjs,esm --out-dir . && tsc index.ts --declaration --emitDeclarationOnly --strict --module nodenext --outDir . && cp index.d.ts index.d.cts",
    "test": "make test",
    "prepublishOnly": "npm run build"
  },
  "homepage": "https://github.com/martinandert/except",
  "repository": {
    "type": "git",
    "url": "https://github.com/martinandert/except.git"
  },
  "bugs": {
    "url": "https://github.com/martinandert/except/issues"
  },
  "keywords": [
    "object",
    "except",
    "omit",
    "without"
  ],
  "author": {
    "name": "Martin Andert",
    "email": "mandert@gmail.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
